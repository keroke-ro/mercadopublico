{
  "name": "mercadopublico",
  "version": "0.1.0",
  "description": "SDK TypeScript para la API de Mercado Público (ChileCompra): v1, Compra Ágil v2 y OCDS en un solo modelo, con control de cuota.",
  "keywords": [
    "mercadopublico",
    "chilecompra",
    "licitaciones",
    "chile",
    "sdk",
    "compras-publicas"
  ],
  "homepage": "https://github.com/keroke-ro/mercadopublico#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keroke-ro/mercadopublico.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "KeroKero (https://www.kerokero.cl)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "radar": [
        "./dist/radar.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./radar": {
      "import": "./dist/radar.js",
      "require": "./dist/radar.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mercadopublico": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/assets/readme",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:tipos": "vitest --typecheck.only --run",
    "cobertura": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "paquete": "node scripts/paquete.mjs",
    "mutacion": "stryker run",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "contrato": "node --experimental-strip-types scripts/contrato.ts",
    "fixtures:grabar": "node --experimental-strip-types scripts/contrato.ts --grabar",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
