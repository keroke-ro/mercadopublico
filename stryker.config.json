{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/http.ts",
    "src/sync.ts",
    "src/personales.ts",
    "src/monto.ts",
    "src/fecha.ts",
    "src/util.ts"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    "reports",
    "test/caos",
    "test/sync-reanudar.test.ts"
  ],
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 83
  },
  "concurrency": 2,
  "timeoutMS": 10000
}
